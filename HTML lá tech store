<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LS Tech Store</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>


<header>

  <div class="logo-area">
    <img src="https://i.ibb.co/JWxqNnWL/logo.png" class="logo" alt="logo">
    <h1>LS Tech Store</h1>
  </div>

  <div class="cart-btn" onclick="toggleCart()">
    🛒 <span id="cart-count">0</span>
  </div>

</header>

<!-- PRODUTOS -->
<main>
  <section id="products" class="products"></section>
</main>


<!-- OVERLAY -->
<div class="overlay" onclick="toggleCart()"></div>

<!-- CARRINHO LATERAL -->
<aside class="cart">
  <h2>Seu Carrinho</h2>

  <ul id="cart-items"></ul>

  <p>Total: R$ <span id="total">0.00</span></p>

  <button class="btn-finalizar" onclick="finalizarCompra()">
    Finalizar no WhatsApp
  </button>
</aside>

<script src="script.js"></script>
</body>
</html>
